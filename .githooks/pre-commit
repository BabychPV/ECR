#!/bin/sh
# =====================================================================
#  pre-commit — контроль зон записи для дво-вузлового процесу PK1/PK2
# =====================================================================
#  ПРИЗНАЧЕННЯ: фізично не дати вузлу закомітити файли поза своєю роллю.
#  PK1 — керуючий вузол (документація, інструкції, автоматизація).
#  PK2 — вузол-виконавець (виробничий код, тести, білд-файли).
#
#  СУМІСНІСТЬ: тільки POSIX sh (жодних [[ ]], масивів, ${var^^}).
#  Працює під sh із комплекту Git for Windows. У репозиторії git 2.19,
#  тому НІДЕ не використовуємо `git restore` / `git switch`
#  (вони з'явилися лише у git 2.23) — у підказках лише `git reset HEAD`.
# ---------------------------------------------------------------------

set -u

# Корінь репозиторію: коміт може бути запущений із підкаталогу,
# а шляхи в .sync-local/NODE і у виводі git diff — відносно кореня.
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$REPO_ROOT" ]; then
    printf '%s\n' "ВІДМОВА КОМІТУ: не вдалося визначити корінь git-репозиторію." >&2
    printf '%s\n' "ВІДНОВЛЕННЯ: виконуйте коміт усередині робочої копії репозиторію." >&2
    exit 1
fi

NODE_FILE="$REPO_ROOT/.sync-local/NODE"

# ---------------------------------------------------------------------
#  ЧОМУ FAIL-CLOSED НА ВІДСУТНЬОМУ NODE:
#  якщо ми не знаємо, який це вузол, ми не знаємо і його зону записи.
#  Дозволити коміт "про всяк випадок" означало б відкрити обидві зони
#  одночасно — тобто саме те, від чого захищає цей хук. Тому невідомий
#  вузол ЗАВЖДИ = відмова і НІКОЛИ = дозвіл.
# ---------------------------------------------------------------------
if [ ! -f "$NODE_FILE" ]; then
    printf '%s\n' "======================================================================" >&2
    printf '%s\n' "ВІДМОВА КОМІТУ: не визначено вузол — файл .sync-local/NODE відсутній" >&2
    printf '%s\n' "======================================================================" >&2
    printf '%s\n' "ЩО НЕ ТАК: хук не може перевірити зону записи, бо не знає, на якому" >&2
    printf '%s\n' "           вузлі виконується коміт. Перевірка навмисно закривається" >&2
    printf '%s\n' "           (fail-closed): невідомий вузол не отримує дозволу ніколи." >&2
    printf '%s\n' "ЯКИЙ ФАЙЛ: $NODE_FILE" >&2
    printf '%s\n' "ВІДНОВЛЕННЯ: виконайте у корені репозиторію одну з команд:" >&2
    printf '%s\n' "  powershell -ExecutionPolicy Bypass -File scripts/install-node.ps1 -Node PK1" >&2
    printf '%s\n' "  powershell -ExecutionPolicy Bypass -File scripts/install-node.ps1 -Node PK2" >&2
    printf '%s\n' "" >&2
    printf '%s\n' "ЗАБОРОНЕНО обходити цю перевірку через --no-verify." >&2
    exit 1
fi

# tr викликаємо один раз на весь хук (а не на кожен файл):
# прибираємо пробіли, таби, CR і LF — щоб NODE був чистим "PK1"/"PK2".
NODE=$(tr -d ' \011\015\012' < "$NODE_FILE")

# Невідоме значення трактуємо так само суворо, як і відсутній файл:
# зіпсований NODE не має ставати "дозволити все".
case "$NODE" in
    PK1|PK2)
        : ;;
    *)
        printf '%s\n' "======================================================================" >&2
        printf '%s\n' "ВІДМОВА КОМІТУ: некоректне значення вузла у .sync-local/NODE" >&2
        printf '%s\n' "======================================================================" >&2
        printf '%s\n' "ЩО НЕ ТАК: очікується рівно PK1 або PK2, а знайдено: '$NODE'" >&2
        printf '%s\n' "ЯКИЙ ФАЙЛ: $NODE_FILE" >&2
        printf '%s\n' "ВІДНОВЛЕННЯ: перевстановіть вузол у корені репозиторію:" >&2
        printf '%s\n' "  powershell -ExecutionPolicy Bypass -File scripts/install-node.ps1 -Node PK1" >&2
        printf '%s\n' "  powershell -ExecutionPolicy Bypass -File scripts/install-node.ps1 -Node PK2" >&2
        printf '%s\n' "" >&2
        printf '%s\n' "ЗАБОРОНЕНО обходити цю перевірку через --no-verify." >&2
        exit 1
        ;;
esac

# Файли у стейджі. core.quotepath=false — щоб кириличні та не-ASCII
# імена у повідомленнях не перетворювалися на \NNN-екранування.
STAGED=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR)

# Порожній стейдж — перевіряти нічого, виходимо тихо і без виводу
# (напр. `git commit --amend` без змін у файлах).
if [ -z "$STAGED" ]; then
    exit 0
fi

VIOLATIONS=0
REPORT=""

# Додає одне порушення до звіту: $1 — шлях, $2 — причина/зона.
# ВІДНОВЛЕННЯ навмисно через `git reset HEAD --`, бо цей синтаксис
# працює і на git < 2.23, де `git restore --staged` ще не існує.
add_violation() {
    VIOLATIONS=$((VIOLATIONS + 1))
    REPORT="$REPORT
  ФАЙЛ: $1
    ЩО НЕ ТАК: $2
    ВІДНОВЛЕННЯ: git reset HEAD -- \"$1\"
"
}

# ---------------------------------------------------------------------
#  ЧОМУ СИМВОЛЬНІ КЛАСИ У ГЛОБАХ ([Ss][Rr][Cc] замість src):
#  на Windows файлова система нечутлива до регістру, отже "SRC/Foo.cs"
#  і "src/Foo.cs" — той самий файл. Без класів обхід зони робився б
#  простою зміною регістру. При цьому ми лишаємося в чистому `case`
#  і НЕ запускаємо grep/tr на кожен файл (це були б десятки процесів
#  на один коміт під Windows, де запуск процесу дорогий).
#
#  ЧОМУ ЦИКЛ ЧИТАЄ З HEREDOC, А НЕ З КОНВЕЄРА:
#  у POSIX sh права частина конвеєра виконується в підпроцесі, тому
#  лічильник VIOLATIONS і текст REPORT після `done` були б втрачені.
#  Перенаправлення з heredoc виконується в поточній оболонці.
#
#  Збираємо ВСІ порушення, а не тільке перше — інакше користувач
#  розбирав би коміт по одному файлу за раз.
# ---------------------------------------------------------------------
while IFS= read -r FILE; do
    [ -n "$FILE" ] || continue

    if [ "$NODE" = "PK1" ]; then
        # PK1 — перелік ЗАБОРОНЕНИХ шляхів: виробничий код, білд-файли,
        # контракти та вихідна тека PK2 (docs/sync/pk2).
        case "$FILE" in
            [Ss][Rr][Cc]/*)
                add_violation "$FILE" "шлях належить зоні PK2: src/** (виробничий код). Вузол PK1 не має права його змінювати."
                ;;
            [Tt][Ee][Ss][Tt][Ss]/*)
                add_violation "$FILE" "шлях належить зоні PK2: tests/** (тести). Вузол PK1 не має права його змінювати."
                ;;
            [Tt][Oo][Oo][Ll][Ss]/*)
                add_violation "$FILE" "шлях належить зоні PK2: tools/** (допоміжні інструменти). Вузол PK1 не має права його змінювати."
                ;;
            [Cc][Oo][Nn][Tt][Rr][Aa][Cc][Tt][Ss]/*)
                add_violation "$FILE" "шлях належить зоні contracts/** — вона заборонена для ОБОХ вузлів і змінюється лише окремою узгодженою процедурою."
                ;;
            [Pp][Kk]2-[Ll][Oo][Gg].[Mm][Dd])
                add_violation "$FILE" "PK2-LOG.md — лог ВИКОНАВЦЯ на гілці sync. Вузол PK1 його ЧИТАЄ (git show origin/sync:PK2-LOG.md), але не пише в нього НІКОЛИ. Свої записи — у PK1-LOG.md."
                ;;
            *.[Cc][Ss][Pp][Rr][Oo][Jj])
                add_violation "$FILE" "шлях належить зоні PK2: *.csproj (файли проєктів). Вузол PK1 не має права його змінювати."
                ;;
            *.[Ss][Ll][Nn])
                add_violation "$FILE" "шлях належить зоні PK2: *.sln (файл рішення). Вузол PK1 не має права його змінювати."
                ;;
            [Dd][Ii][Rr][Ee][Cc][Tt][Oo][Rr][Yy].*.[Pp][Rr][Oo][Pp][Ss])
                add_violation "$FILE" "шлях належить зоні PK2: Directory.*.props (централізовані налаштування збірки). Вузол PK1 не має права його змінювати."
                ;;
            */[Dd][Ii][Rr][Ee][Cc][Tt][Oo][Rr][Yy].*.[Pp][Rr][Oo][Pp][Ss])
                add_violation "$FILE" "шлях належить зоні PK2: Directory.*.props (централізовані налаштування збірки). Вузол PK1 не має права його змінювати."
                ;;
        esac
    else
        # PK2 — білий список (allow-list).
        # ЧОМУ ALLOW-LIST, А НЕ DENY-LIST: дозволена зона PK2 вузька й
        # повністю перелічувана, а заборонена — це "все інше" в репо.
        # За allow-list будь-який новий каталог у корені за замовчуванням
        # закритий для виконавця; за deny-list кожне розширення
        # репозиторію тихо розширювало б і його права.
        case "$FILE" in
            [Ss][Rr][Cc]/*) : ;;
            [Tt][Ee][Ss][Tt][Ss]/*) : ;;
            [Tt][Oo][Oo][Ll][Ss]/*) : ;;
            *.[Cc][Ss][Pp][Rr][Oo][Jj]) : ;;
            *.[Ss][Ll][Nn]) : ;;
            [Dd][Ii][Rr][Ee][Cc][Tt][Oo][Rr][Yy].*.[Pp][Rr][Oo][Pp][Ss]) : ;;
            */[Dd][Ii][Rr][Ee][Cc][Tt][Oo][Rr][Yy].*.[Pp][Rr][Oo][Pp][Ss]) : ;;
            [Pp][Kk]2-[Ll][Oo][Gg].[Mm][Dd]) : ;;
            [Pp][Kk]1-[Ll][Oo][Gg].[Mm][Dd])
                add_violation "$FILE" "PK1-LOG.md — лог КЕРУЮЧОГО на гілці sync. Вузол PK2 його ЧИТАЄ (git show origin/sync:PK1-LOG.md), але не пише в нього НІКОЛИ. Свої записи — у PK2-LOG.md."
                ;;
            [Cc][Oo][Nn][Tt][Rr][Aa][Cc][Tt][Ss]/*)
                add_violation "$FILE" "шлях належить зоні contracts/** — вона заборонена для ОБОХ вузлів і змінюється лише окремою узгодженою процедурою."
                ;;
            [Dd][Oo][Cc][Ss]/*)
                add_violation "$FILE" "шлях належить зоні PK1: docs/** (документація). Вузол PK2 у docs/ не пише зовсім: його лог — PK2-LOG.md на гілці sync."
                ;;
            [Cc][Ll][Aa][Uu][Dd][Ee].[Mm][Dd])
                add_violation "$FILE" "шлях належить зоні PK1: CLAUDE.md (інструкції для агента). Вузол PK2 не має права його змінювати."
                ;;
            .[Gg][Ii][Tt][Hh][Oo][Oo][Kk][Ss]/*)
                add_violation "$FILE" "шлях належить зоні PK1: .githooks/** (самі хуки). Вузол PK2 не може змінювати правила, які його обмежують."
                ;;
            .[Gg][Ii][Tt][Hh][Uu][Bb]/*)
                add_violation "$FILE" "шлях належить зоні PK1: .github/** (CI та шаблони PR). Вузол PK2 не має права його змінювати."
                ;;
            .[Cc][Ll][Aa][Uu][Dd][Ee]/*)
                add_violation "$FILE" "шлях належить зоні PK1: .claude/** (конфігурація агента). Вузол PK2 не має права його змінювати."
                ;;
            [Ss][Cc][Rr][Ii][Pp][Tt][Ss]/*)
                add_violation "$FILE" "шлях належить зоні PK1: scripts/** (сервісні скрипти). Вузол PK2 не має права його змінювати."
                ;;
            *)
                add_violation "$FILE" "шлях поза дозволеною зоною PK2. Вузол PK2 може писати лише у: src/**, tests/**, tools/**, *.csproj, *.sln, Directory.*.props (у main) і PK2-LOG.md (на гілці sync)."
                ;;
        esac
    fi
done <<STAGED_FILE_LIST_EOF
$STAGED
STAGED_FILE_LIST_EOF

if [ "$VIOLATIONS" -eq 0 ]; then
    exit 0
fi

if [ "$NODE" = "PK1" ]; then
    NODE_ROLE="PK1 (керуючий вузол)"
    HANDOFF="передайте роботу вузлу PK2 через директиву в docs/sync/."
else
    NODE_ROLE="PK2 (вузол-виконавець)"
    HANDOFF="опишіть потребу записом ASK у PK2-LOG.md (гілка sync) і дочекайтеся настанови від PK1."
fi

printf '%s\n' "======================================================================" >&2
printf '%s\n' "ВІДМОВА КОМІТУ: вузол вийшов за межі своєї зони записи" >&2
printf '%s\n' "======================================================================" >&2
printf '%s\n' "Вузол: $NODE_ROLE" >&2
printf '%s\n' "Порушень: $VIOLATIONS" >&2
printf '%s\n' "$REPORT" >&2
printf '%s\n' "Знявши зі стейджу всі перелічені файли, повторіть коміт." >&2
printf '%s\n' "ЗАБОРОНЕНО обходити цю перевірку через --no-verify." >&2
printf '%s\n' "Відхилений коміт означає, що вузол залишив свою зону: $HANDOFF" >&2
exit 1
