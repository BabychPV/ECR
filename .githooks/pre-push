#!/bin/sh
# =====================================================================
#  pre-push — базова гігієна git (прив'язку до вузла PK1/PK2 знято)
# =====================================================================
#  2026-09-08, пряме рішення людини: іменний простір гілок за вузлом
#  (pk1/*, pk2/*) прибрано разом із рештою зональних бар'єрів — він
#  ставав тим самим «ASK і чекай», що й зональні заборони в
#  pre-commit, і людина попросила прибрати механізм цілком.
#
#  ЩО ЛИШИЛОСЯ — і це НЕ той механізм: заборона прямого пушу в main і
#  заборона force-push — не зональний бар'єр, а базова гігієна git,
#  застосовна незалежно від того, хто пише. Вона нікого не сповільнює:
#  мерж уже автономний і миттєвий (CLAUDE.md, розділ PK2), тож PR —
#  не черга на дозвіл, а спосіб дати шести гейтам CI відпрацювати
#  ДО того, як зміна потрапить у main.
#
#  СУМІСНІСТЬ: тільки POSIX sh. Git 2.19 — жодних `git restore`/`switch`.
#  STDIN хука: рядки "<local ref> <local sha> <remote ref> <remote sha>".
# ---------------------------------------------------------------------

set -u

REJECTED=0

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    [ -n "${REMOTE_REF:-}" ] || continue

    case "$LOCAL_SHA" in
        *[!0]*) IS_DELETE=0 ;;
        *)      IS_DELETE=1 ;;
    esac
    [ "$IS_DELETE" -eq 1 ] && continue

    case "$REMOTE_REF" in
        refs/heads/[Mm][Aa][Ii][Nn])
            REJECTED=$((REJECTED + 1))
            printf '%s\n' "======================================================================" >&2
            printf '%s\n' "ВІДМОВА PUSH: пряме надсилання у гілку main заборонене" >&2
            printf '%s\n' "======================================================================" >&2
            printf '%s\n' "ЩО НЕ ТАК: спроба надіслати коміти напряму у захищену гілку." >&2
            printf '%s\n' "ЯКА ГІЛКА: $REMOTE_REF (локальне джерело: $LOCAL_REF)" >&2
            printf '%s\n' "ЧОМУ: main закрита — уся робота потрапляє туди ВИКЛЮЧНО через" >&2
            printf '%s\n' "      Pull Request, щоб шість гейтів CI відпрацювали ДО мержу." >&2
            printf '%s\n' "ВІДНОВЛЕННЯ: перенесіть роботу у власну гілку і надішліть її:" >&2
            printf '%s\n' "  git checkout -b <коротка-назва>" >&2
            printf '%s\n' "  git push -u origin <коротка-назва>" >&2
            printf '%s\n' "Далі відкрийте Pull Request у main." >&2
            printf '%s\n' "" >&2
            printf '%s\n' "ЗАБОРОНЕНО обходити цю перевірку через --no-verify." >&2
            continue
            ;;
    esac

    case "$REMOTE_SHA" in
        *[!0]*)
            if git merge-base --is-ancestor "$REMOTE_SHA" "$LOCAL_SHA" >/dev/null 2>&1 </dev/null; then
                :
            else
                REJECTED=$((REJECTED + 1))
                printf '%s\n' "======================================================================" >&2
                printf '%s\n' "ВІДМОВА PUSH: перезапис історії (non-fast-forward) заборонений" >&2
                printf '%s\n' "======================================================================" >&2
                printf '%s\n' "ЩО НЕ ТАК: віддалений коміт $REMOTE_SHA не є предком локального" >&2
                printf '%s\n' "           $LOCAL_SHA, тому push видалив би вже опубліковані коміти" >&2
                printf '%s\n' "           (force-push / rebase опублікованої гілки)." >&2
                printf '%s\n' "ЯКА ГІЛКА: $REMOTE_REF (локальне джерело: $LOCAL_REF)" >&2
                printf '%s\n' "ВІДНОВЛЕННЯ: заберіть віддалені зміни через merge (НЕ rebase):" >&2
                printf '%s\n' "  git fetch origin" >&2
                printf '%s\n' "  git merge origin/${REMOTE_REF#refs/heads/}" >&2
                printf '%s\n' "  git push origin ${REMOTE_REF#refs/heads/}" >&2
                printf '%s\n' "" >&2
                printf '%s\n' "ЗАБОРОНЕНО обходити цю перевірку через --no-verify." >&2
                continue
            fi
            ;;
    esac
done

if [ "$REJECTED" -gt 0 ]; then
    printf '%s\n' "" >&2
    printf '%s\n' "Відхилено посилань (refs): $REJECTED. Push не виконано повністю." >&2
    exit 1
fi

exit 0
