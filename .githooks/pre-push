#!/bin/sh
# =====================================================================
#  pre-push — захист main та іменного простору гілок для PK1/PK2
# =====================================================================
#  ПРАВИЛА:
#   1. Пряме надсилання у main заборонене для ОБОХ вузлів — уся робота
#      йде через Pull Request (branch protection на боці сервера, цей
#      хук лише зупиняє помилку локально, до відмови сервера).
#   2. Перезапис історії (non-fast-forward) заборонений.
#   3. Видалення гілки дозволене.
#   4. PK1 надсилає лише гілки pk1/*, PK2 — лише pk2/*.
#
#  СУМІСНІСТЬ: тільки POSIX sh (жодних [[ ]], масивів).
#  Git 2.19 — жодних `git restore` / `git switch`.
#
#  STDIN хука: рядки "<local ref> <local sha> <remote ref> <remote sha>".
# ---------------------------------------------------------------------

set -u

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
NODE_FILE="$REPO_ROOT/.sync-local/NODE"

# ---------------------------------------------------------------------
#  ЧОМУ FAIL-CLOSED НА ВІДСУТНЬОМУ NODE: без вузла неможливо перевірити
#  префікс гілки, а дозволений push у чужий іменний простір ламає
#  розподіл ролей уже на сервері, де відкотити його значно дорожче.
# ---------------------------------------------------------------------
if [ ! -f "$NODE_FILE" ]; then
    printf '%s\n' "======================================================================" >&2
    printf '%s\n' "ВІДМОВА PUSH: не визначено вузол — файл .sync-local/NODE відсутній" >&2
    printf '%s\n' "======================================================================" >&2
    printf '%s\n' "ЩО НЕ ТАК: неможливо перевірити, чи гілка належить іменному простору" >&2
    printf '%s\n' "           цього вузла. Перевірка навмисно закривається (fail-closed)." >&2
    printf '%s\n' "ЯКИЙ ФАЙЛ: $NODE_FILE" >&2
    printf '%s\n' "ВІДНОВЛЕННЯ: виконайте у корені репозиторію одну з команд:" >&2
    printf '%s\n' "  powershell -ExecutionPolicy Bypass -File scripts/install-node.ps1 -Node PK1" >&2
    printf '%s\n' "  powershell -ExecutionPolicy Bypass -File scripts/install-node.ps1 -Node PK2" >&2
    printf '%s\n' "" >&2
    printf '%s\n' "ЗАБОРОНЕНО обходити цю перевірку через --no-verify." >&2
    exit 1
fi

NODE=$(tr -d ' \011\015\012' < "$NODE_FILE")

case "$NODE" in
    PK1)
        BRANCH_PREFIX="pk1/" ;;
    PK2)
        BRANCH_PREFIX="pk2/" ;;
    *)
        printf '%s\n' "======================================================================" >&2
        printf '%s\n' "ВІДМОВА PUSH: некоректне значення вузла у .sync-local/NODE" >&2
        printf '%s\n' "======================================================================" >&2
        printf '%s\n' "ЩО НЕ ТАК: очікується рівно PK1 або PK2, а знайдено: '$NODE'" >&2
        printf '%s\n' "ЯКИЙ ФАЙЛ: $NODE_FILE" >&2
        printf '%s\n' "ВІДНОВЛЕННЯ: перевстановіть вузол:" >&2
        printf '%s\n' "  powershell -ExecutionPolicy Bypass -File scripts/install-node.ps1 -Node PK1" >&2
        printf '%s\n' "  powershell -ExecutionPolicy Bypass -File scripts/install-node.ps1 -Node PK2" >&2
        printf '%s\n' "" >&2
        printf '%s\n' "ЗАБОРОНЕНО обходити цю перевірку через --no-verify." >&2
        exit 1
        ;;
esac

REJECTED=0

# Читаємо stdin напряму (не через конвеєр), щоб REJECTED зберігся
# після завершення циклу: у POSIX sh права частина конвеєра — окремий
# процес, і лічильник у ньому був би втрачений.
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    [ -n "${REMOTE_REF:-}" ] || continue

    # Коротке ім'я віддаленої гілки: refs/heads/pk1/foo -> pk1/foo
    REMOTE_BRANCH=${REMOTE_REF#refs/heads/}

    # -----------------------------------------------------------------
    #  ВИДАЛЕННЯ ГІЛКИ: локальний sha з одних нулів. Дозволяємо і не
    #  застосовуємо ані перевірку префікса, ані перевірку історії —
    #  прибирання злитої гілки є нормальною частиною процесу PR.
    #  Перевірку "усі нулі" робимо глобом: якщо у рядку є будь-який
    #  символ, окрім '0', це реальний sha.
    # -----------------------------------------------------------------
    case "$LOCAL_SHA" in
        *[!0]*)
            IS_DELETE=0 ;;
        *)
            IS_DELETE=1 ;;
    esac

    if [ "$IS_DELETE" -eq 1 ]; then
        continue
    fi

    # -----------------------------------------------------------------
    #  1. ЗАБОРОНА PUSH У main (для обох вузлів).
    #  Порівняння з символьними класами — щоб "Main"/"MAIN" не
    #  проходили на нечутливих до регістру налаштуваннях.
    # -----------------------------------------------------------------
    case "$REMOTE_REF" in
        refs/heads/[Mm][Aa][Ii][Nn])
            REJECTED=$((REJECTED + 1))
            printf '%s\n' "======================================================================" >&2
            printf '%s\n' "ВІДМОВА PUSH: пряме надсилання у гілку main заборонене" >&2
            printf '%s\n' "======================================================================" >&2
            printf '%s\n' "Вузол: $NODE" >&2
            printf '%s\n' "ЩО НЕ ТАК: спроба надіслати коміти напряму у захищену гілку." >&2
            printf '%s\n' "ЯКА ГІЛКА: $REMOTE_REF (локальне джерело: $LOCAL_REF)" >&2
            printf '%s\n' "ЧОМУ: main закрита branch protection — уся робота обох вузлів" >&2
            printf '%s\n' "      потрапляє у main ВИКЛЮЧНО через Pull Request із рецензією." >&2
            printf '%s\n' "ВІДНОВЛЕННЯ: перенесіть роботу у власну гілку і надішліть її:" >&2
            printf '%s\n' "  git checkout -b ${BRANCH_PREFIX}<коротка-назва>" >&2
            printf '%s\n' "  git push -u origin ${BRANCH_PREFIX}<коротка-назва>" >&2
            printf '%s\n' "Далі відкрийте Pull Request у main." >&2
            printf '%s\n' "" >&2
            printf '%s\n' "ЗАБОРОНЕНО обходити цю перевірку через --no-verify." >&2
            continue
            ;;
    esac

    # -----------------------------------------------------------------
    #  2. ЗАБОРОНА ПЕРЕЗАПИСУ ІСТОРІЇ.
    #  ЧОМУ САМЕ ТАК: хук не бачить надійно ані --force, ані --force-
    #  with-lease (git не передає їх у pre-push). Тому визначаємо
    #  наслідок, а не флаг: якщо віддалений sha існує (не нулі) і НЕ є
    #  предком локального, то push замінив би вже опубліковані коміти
    #  — це і є перезапис історії.
    # -----------------------------------------------------------------
    case "$REMOTE_SHA" in
        *[!0]*)
            # Віддалена гілка існує — перевіряємо fast-forward.
            # </dev/null — щоб git не спробував читати stdin хука.
            if git merge-base --is-ancestor "$REMOTE_SHA" "$LOCAL_SHA" >/dev/null 2>&1 </dev/null; then
                : # fast-forward, усе гаразд
            else
                REJECTED=$((REJECTED + 1))
                printf '%s\n' "======================================================================" >&2
                printf '%s\n' "ВІДМОВА PUSH: перезапис історії (non-fast-forward) заборонений" >&2
                printf '%s\n' "======================================================================" >&2
                printf '%s\n' "Вузол: $NODE" >&2
                printf '%s\n' "ЩО НЕ ТАК: віддалений коміт $REMOTE_SHA не є предком локального" >&2
                printf '%s\n' "           $LOCAL_SHA, тому push видалив би вже опубліковані" >&2
                printf '%s\n' "           коміти (force-push / rebase опублікованої гілки)." >&2
                printf '%s\n' "ЯКА ГІЛКА: $REMOTE_REF (локальне джерело: $LOCAL_REF)" >&2
                printf '%s\n' "ЧОМУ: другий вузол міг уже забрати ці коміти; перезапис зробив" >&2
                printf '%s\n' "      би його копію несумісною і зруйнував журнал процесу." >&2
                printf '%s\n' "ВІДНОВЛЕННЯ: заберіть віддалені зміни через merge (НЕ rebase):" >&2
                printf '%s\n' "  git fetch origin" >&2
                printf '%s\n' "  git merge origin/$REMOTE_BRANCH" >&2
                printf '%s\n' "  git push origin $REMOTE_BRANCH" >&2
                printf '%s\n' "Якщо гілку справді потрібно замінити — створіть нову:" >&2
                printf '%s\n' "  git checkout -b ${BRANCH_PREFIX}<коротка-назва>-v2" >&2
                printf '%s\n' "" >&2
                printf '%s\n' "ЗАБОРОНЕНО обходити цю перевірку через --no-verify." >&2
                continue
            fi
            ;;
    esac

    # -----------------------------------------------------------------
    #  3. ІМЕННИЙ ПРОСТІР ГІЛОК ЗА ВУЗЛОМ.
    #  Символьні класи — захист від обходу через регістр (Windows та
    #  нечутливі до регістру сервери трактують PK2/x і pk2/x однаково).
    # -----------------------------------------------------------------
    PREFIX_OK=0
    if [ "$NODE" = "PK1" ]; then
        case "$REMOTE_BRANCH" in
            [Pp][Kk]1/?*) PREFIX_OK=1 ;;
        esac
    else
        case "$REMOTE_BRANCH" in
            [Pp][Kk]2/?*) PREFIX_OK=1 ;;
        esac
    fi

    if [ "$PREFIX_OK" -eq 0 ]; then
        REJECTED=$((REJECTED + 1))
        printf '%s\n' "======================================================================" >&2
        printf '%s\n' "ВІДМОВА PUSH: гілка поза іменним простором вузла $NODE" >&2
        printf '%s\n' "======================================================================" >&2
        printf '%s\n' "Вузол: $NODE" >&2
        printf '%s\n' "ЩО НЕ ТАК: ім'я гілки не починається з '$BRANCH_PREFIX'." >&2
        printf '%s\n' "ЯКА ГІЛКА: $REMOTE_BRANCH (повний ref: $REMOTE_REF)" >&2
        printf '%s\n' "ЧОМУ: за префіксом гілки видно, який вузол її створив; це робить" >&2
        printf '%s\n' "      розподіл ролей видимим у PR і не дає вузлам писати у гілки" >&2
        printf '%s\n' "      одне одного." >&2
        printf '%s\n' "ВІДНОВЛЕННЯ: перейменуйте гілку і надішліть її під правильним іменем:" >&2
        printf '%s\n' "  git branch -m ${BRANCH_PREFIX}$REMOTE_BRANCH" >&2
        printf '%s\n' "  git push -u origin ${BRANCH_PREFIX}$REMOTE_BRANCH" >&2
        printf '%s\n' "" >&2
        printf '%s\n' "ЗАБОРОНЕНО обходити цю перевірку через --no-verify." >&2
        continue
    fi
done

if [ "$REJECTED" -gt 0 ]; then
    printf '%s\n' "" >&2
    printf '%s\n' "Відхилено посилань (refs): $REJECTED. Push не виконано повністю." >&2
    exit 1
fi

exit 0
