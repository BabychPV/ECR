#!/bin/sh
# =====================================================================
#  commit-msg — формат повідомлення коміту для процесу PK1/PK2
# =====================================================================
#  ФОРМАТ: [PK1|PK2][TYPE] опис
#  Тег вузла в повідомленні мусить збігатися з .sync-local/NODE —
#  це блокує підміну авторства (вузол PK2 не може підписатися як PK1
#  і навпаки), бо історія коміту є єдиним журналом дво-вузлового
#  процесу.
#
#  СУМІСНІСТЬ: тільки POSIX sh. Git 2.19 — жодних `git restore`/`switch`.
# ---------------------------------------------------------------------

set -u

MSG_FILE=${1:-}
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
    printf '%s\n' "ВІДМОВА КОМІТУ: хуку commit-msg не передано файл повідомлення." >&2
    printf '%s\n' "ВІДНОВЛЕННЯ: не запускайте цей хук вручну; виконайте звичайний git commit." >&2
    exit 1
fi

ALLOWED_TYPES="DIR, ANSWER, VERDICT, STATUS, CODE, BLOCK, DELTA, CHORE"

# ---------------------------------------------------------------------
#  MERGE-КОМІТИ ПРОПУСКАЄМО.
#  ЧОМУ: текст "Merge branch ..." генерує сам git, він не підпадає під
#  наш формат, і вимагати від нього тег вузла означало б зробити
#  об'єднання гілок неможливим — а весь процес побудований на PR.
# ---------------------------------------------------------------------
if [ -f "$(git rev-parse --git-dir 2>/dev/null)/MERGE_HEAD" ]; then
    exit 0
fi

FIRST_LINE=$(head -n 1 "$MSG_FILE")

# Прибираємо можливий CR у кінці рядка: під Windows редактор може
# зберегти повідомлення з CRLF, і тоді опис "виглядав" би непорожнім,
# а тег — некоректним.
CR=$(printf '\r')
case "$FIRST_LINE" in
    *"$CR") FIRST_LINE=${FIRST_LINE%"$CR"} ;;
esac

case "$FIRST_LINE" in
    "Merge "*) exit 0 ;;
esac

# Маркер конфліктного об'єднання у тілі повідомлення (git дописує
# блок "# Conflicts:") — теж ознака merge-коміту.
if grep -q '^# Conflicts:' "$MSG_FILE" 2>/dev/null; then
    exit 0
fi

# ---------------------------------------------------------------------
#  Читаємо вузол. ЧОМУ FAIL-CLOSED: без NODE неможливо перевірити,
#  чи вузол не підписався чужим тегом, а неперевірений підпис у
#  журналі процесу гірший за відхилений коміт.
# ---------------------------------------------------------------------
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
NODE_FILE="$REPO_ROOT/.sync-local/NODE"

if [ ! -f "$NODE_FILE" ]; then
    printf '%s\n' "======================================================================" >&2
    printf '%s\n' "ВІДМОВА КОМІТУ: не визначено вузол — файл .sync-local/NODE відсутній" >&2
    printf '%s\n' "======================================================================" >&2
    printf '%s\n' "ЩО НЕ ТАК: неможливо перевірити, що тег вузла у повідомленні коміту" >&2
    printf '%s\n' "           відповідає реальному вузлу. Перевірка закривається" >&2
    printf '%s\n' "           (fail-closed), щоб унеможливити підміну авторства." >&2
    printf '%s\n' "ЯКИЙ ФАЙЛ: $NODE_FILE" >&2
    printf '%s\n' "ВІДНОВЛЕННЯ: виконайте у корені репозиторію одну з команд:" >&2
    printf '%s\n' "  powershell -ExecutionPolicy Bypass -File scripts/install-node.ps1 -Node PK1" >&2
    printf '%s\n' "  powershell -ExecutionPolicy Bypass -File scripts/install-node.ps1 -Node PK2" >&2
    printf '%s\n' "" >&2
    printf '%s\n' "ЗАБОРОНЕНО обходити цю перевірку через --no-verify." >&2
    exit 1
fi

NODE=$(tr -d ' \011\015\012' < "$NODE_FILE")

case "$NODE" in
    PK1|PK2)
        : ;;
    *)
        printf '%s\n' "======================================================================" >&2
        printf '%s\n' "ВІДМОВА КОМІТУ: некоректне значення вузла у .sync-local/NODE" >&2
        printf '%s\n' "======================================================================" >&2
        printf '%s\n' "ЩО НЕ ТАК: очікується рівно PK1 або PK2, а знайдено: '$NODE'" >&2
        printf '%s\n' "ЯКИЙ ФАЙЛ: $NODE_FILE" >&2
        printf '%s\n' "ВІДНОВЛЕННЯ: перевстановіть вузол:" >&2
        printf '%s\n' "  powershell -ExecutionPolicy Bypass -File scripts/install-node.ps1 -Node $NODE" >&2
        printf '%s\n' "  (замініть значення на PK1 або PK2)" >&2
        printf '%s\n' "" >&2
        printf '%s\n' "ЗАБОРОНЕНО обходити цю перевірку через --no-verify." >&2
        exit 1
        ;;
esac

# Друкує повний довідник формату і завершує коміт відмовою.
# $1 — конкретна причина (ЩО НЕ ТАК).
reject() {
    printf '%s\n' "======================================================================" >&2
    printf '%s\n' "ВІДМОВА КОМІТУ: некоректне повідомлення коміту" >&2
    printf '%s\n' "======================================================================" >&2
    printf '%s\n' "ЩО НЕ ТАК: $1" >&2
    printf '%s\n' "ЯКИЙ ФАЙЛ: $MSG_FILE (перший рядок повідомлення)" >&2
    printf '%s\n' "ФАКТИЧНИЙ ПЕРШИЙ РЯДОК: $FIRST_LINE" >&2
    printf '%s\n' "" >&2
    printf '%s\n' "ОЧІКУВАНИЙ ФОРМАТ: [$NODE][TYPE] опис" >&2
    printf '%s\n' "  - тег вузла мусить бути рівно [$NODE] (значення з .sync-local/NODE);" >&2
    printf '%s\n' "  - TYPE — великими літерами, з переліку нижче;" >&2
    printf '%s\n' "  - опис не може бути порожнім." >&2
    printf '%s\n' "ДОЗВОЛЕНІ TYPE: $ALLOWED_TYPES" >&2
    printf '%s\n' "ПРИКЛАД: [$NODE][CHORE] оновлено конфігурацію збірки" >&2
    printf '%s\n' "" >&2
    printf '%s\n' "ВІДНОВЛЕННЯ: повторіть коміт із правильним повідомленням:" >&2
    printf '%s\n' "  git commit -m \"[$NODE][CHORE] короткий опис змін\"" >&2
    printf '%s\n' "Якщо коміт уже створено і треба лише виправити текст:" >&2
    printf '%s\n' "  git commit --amend -m \"[$NODE][CHORE] короткий опис змін\"" >&2
    printf '%s\n' "" >&2
    printf '%s\n' "ЗАБОРОНЕНО обходити цю перевірку через --no-verify." >&2
    exit 1
}

if [ -z "$FIRST_LINE" ]; then
    reject "перший рядок повідомлення порожній."
fi

# --- Тег вузла -------------------------------------------------------
MSG_NODE=""
case "$FIRST_LINE" in
    "[PK1]"*) MSG_NODE="PK1" ;;
    "[PK2]"*) MSG_NODE="PK2" ;;
    *) reject "повідомлення не починається з тега вузла [PK1] або [PK2]." ;;
esac

if [ "$MSG_NODE" != "$NODE" ]; then
    reject "тег вузла у повідомленні — [$MSG_NODE], а фактичний вузол за .sync-local/NODE — $NODE. Підпис чужим тегом (підміна авторства) заборонений."
fi

# Відрізаємо тег вузла. Лапки всередині ${...#"..."} роблять шаблон
# літеральним — інакше [ ] сприймалися б як символьний клас глоба.
REST=${FIRST_LINE#"[$MSG_NODE]"}

# --- Тег типу --------------------------------------------------------
case "$REST" in
    "["*"]"*)
        : ;;
    *)
        reject "після тега вузла бракує тега типу у квадратних дужках, напр. [CODE]." ;;
esac

MSG_TYPE=${REST#"["}
MSG_TYPE=${MSG_TYPE%%"]"*}
DESC=${REST#*"]"}

if [ -z "$MSG_TYPE" ]; then
    reject "тег типу порожній: знайдено []."
fi

case "$MSG_TYPE" in
    DIR|ANSWER|VERDICT|STATUS|CODE|BLOCK|DELTA|CHORE)
        : ;;
    *)
        reject "тип '$MSG_TYPE' не входить до переліку дозволених типів (регістр має значення: тільки великі літери)." ;;
esac

# --- Опис ------------------------------------------------------------
# Обрізаємо провідні пробіли й таби посимвольно: у POSIX sh немає
# ${var##[[:space:]]*} з жадібним відкиданням лише пробілів.
while :; do
    case "$DESC" in
        " "*) DESC=${DESC#?} ;;
        "	"*) DESC=${DESC#?} ;;
        *) break ;;
    esac
done

if [ -z "$DESC" ]; then
    reject "опис після тегів порожній — потрібен змістовний текст після [$MSG_NODE][$MSG_TYPE]."
fi

exit 0
