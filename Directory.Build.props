<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Попередження = помилки. Дисципліна дешевша за розбір «чому воно так» через рік. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      BOOTSTRAP-FIX (Q-006): аналізатори стилю й іменування не роблять збірку червоною.
      Причина: скелет із docs/build/05* створюється ДОСЛІВНО, а частина його коду
      суперечить власним правилам пакета (CA1711 вимагає перейменувати тип Permission,
      CA1720 — члени ColumnDataType.String/Int/Decimal; і те, і те заборонено чіпати).
      Правила лишаються увімкненими як ПОПЕРЕДЖЕННЯ — вони видимі, але не блокують.
    -->
    <WarningsNotAsErrors>IDE0011;IDE0040;IDE0065;CA1707;CA1711;CA1716;CA1720;CA1725;CA1822;CS0169;CS0414;CS9113;CS1572;CS1573;CS1574;CS1580;CS1584;xUnit1026</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: не вимагаємо XML-doc на кожному члені в тестах і tools -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

</Project>
