<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Попередження = помилки. Дисципліна дешевша за розбір «чому воно так» через рік. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      BOOTSTRAP-FIX (Q-006): аналізатори стилю й іменування не роблять збірку червоною.
      Причина: скелет із docs/build/05* створюється ДОСЛІВНО, а частина його коду
      суперечить власним правилам пакета (CA1711 вимагає перейменувати тип Permission,
      CA1720 — члени ColumnDataType.String/Int/Decimal; і те, і те заборонено чіпати).
      Правила лишаються увімкненими як ПОПЕРЕДЖЕННЯ — вони видимі, але не блокують.

      ⛔ Свідомо НЕ виключені, хоча теж спрацьовують на скелеті:
         CS1574/CS1580/CS1584 — нерозв'язний <see cref>. У пакеті, який тримається
         на контрактах, зламаний cref — це сигнал, що тип перейменували або втратили,
         і глушити його не можна (рев'ю Етапу 0, В-4).
         CS8600/8602/8603/8618 (nullable), CS4014 (async) — лишаються помилками
         через .editorconfig.
      Послаблення, потрібні лише тестам (CA1707, xUnit1026), винесені в
      tests/Directory.Build.props і на src/ не діють.
    -->
    <WarningsNotAsErrors>CA1711;CA1716;CA1720;CA1725;CA1822;CS0169;CS0414;CS9113</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: не вимагаємо XML-doc на кожному члені в тестах і tools -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!--
      ⚠ false, а не true, попри `docs/tz/08-nfr.md` §90 (`Q-040`).
      Причина не стильова: у режимі globalization-invariant
      `Microsoft.Data.SqlClient` НЕ ВІДКРИВАЄ з'єднання взагалі —
      `System.NotSupportedException: Globalization Invariant Mode is not
      supported` на `SqlConnection.Open()`. Тобто з `true` застосунок не може
      дійти до бази, і жоден інтеграційний тест не стартує.

      Намір NFR — «форматування чисел і дат не залежить від локалі сервера» —
      лишається чинним, але тримається явним `CultureInfo.InvariantCulture` у
      місцях форматування (за цим стежить CA1305), а не режимом середовища.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

</Project>
