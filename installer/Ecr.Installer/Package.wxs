<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    UpgradeCode НЕ ЗМІНЮЄТЬСЯ НІКОЛИ, за весь час життя продукту. Це той
    ідентифікатор, за яким Windows розуміє «це те саме, що вже стоїть».
    Зміна UpgradeCode дає дві паралельні установки замість оновлення —
    помилка, яку виявляють уже в продуктиві.
  -->
  <Package Name="!(loc.ProductName)"
           Manufacturer="!(loc.Manufacturer)"
           Version="$(ProductVersion)"
           UpgradeCode="8f3a1d64-2b7e-4c19-9a55-6d0e7b41c832"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500"
           Language="1033">

    <SummaryInformation Description="!(loc.ProductName) $(ProductVersion)" />

    <!--
      Покриває перевстановлення, оновлення і блокування відкату однією
      декларацією. afterInstallInitialize: стара версія знімається ПІСЛЯ
      початку установки нової, тому збій відкатує до робочої старої, а не
      лишає сервер без служби (docs/build/10-installer.md §1.5).
    -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="!(loc.DowngradeError)" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Вимоги до платформи. Перевірка ДО будь-яких змін у системі. -->
    <Launch Condition="Installed OR VersionNT64 &gt;= 603"
            Message="!(loc.RequireWin2012R2)" />
    <Launch Condition="Installed OR Privileged"
            Message="!(loc.RequireAdmin)" />

    <!-- ───────────── Властивості ───────────── -->

    <!-- Обліковий запис служби. Порожній = служба не стартує (§1.4). -->
    <Property Id="SERVICE_ACCOUNT" Secure="yes" />

    <!--
      Hidden="yes": пароль не потрапляє в лог MSI (компілятор сам заповнює
      MsiHiddenProperties із цього атрибута — авторити цю службову властивість
      як окремий Property заборонено, WIX0070).
      msiexec /l*v за замовчуванням пише всі властивості у файл на диску.
    -->
    <Property Id="SERVICE_PASSWORD" Secure="yes" Hidden="yes" />

    <Property Id="APP_PORT" Value="5000" Secure="yes" />

    <!--
      Служба EcrWorker (пул перерахунку, ФВ-9.8, D-206; Worker.wxs). Типово 1
      (з I2-2, 2026-09-30): служба реєструється і стартує на свіжій установці
      й на КОЖНОМУ оновленні — властивість не запам'ятовується, тож оновлення
      без неї не може мовчки зняти виконавця, на якого розраховує Api з
      Jobs:Recalculation:Executor = Worker. Вимкнути: WORKER_ENABLED=0.
      ⚠ Режим Api MSI не пише: Executor = Worker пише лише deploy-ecr.ps1 і лише
      разом зі службою; без нього Api лишається InProcess, і служба просто
      простоює — виконавець перерахунку є в будь-якому разі.
      Secure: значення має дійти з клієнтської частини у серверну при /qn і UI.
    -->
    <Property Id="WORKER_ENABLED" Value="1" Secure="yes" />

    <!-- ───────────── Склад ───────────── -->

    <Feature Id="Main" Title="!(loc.FeatureMain)" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="AppFolders" />
      <ComponentGroupRef Id="AppService" />
      <!-- Умовна всередині (WORKER_ENABLED), тому окрема фіча не потрібна. -->
      <ComponentGroupRef Id="WorkerService" />
    </Feature>

    <!-- ───────────── UI ───────────── -->

    <!--
      MSI-діалоги не можуть виглядати сучасно — це обмеження формату, не
      наше рішення (докладніше — docs/build/10-installer.md §5.6). Для
      серверного продукту головний шлях установки все одно тихий (/qn),
      тому UI лишається мінімальним і надійним.
    -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
