<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Fragment>
    <ComponentGroup Id="AppService" Directory="INSTALLFOLDER">
      <Component Id="EcrService" Guid="*">

        <File Id="EcrApiExe" Source="$(PublishDir)\Ecr.Api.exe" KeyPath="yes" />

        <ServiceInstall Id="EcrApiServiceInstall"
                        Name="EcrApi"
                        DisplayName="!(loc.ServiceDisplayName)"
                        Description="!(loc.ServiceDescription)"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="[SERVICE_ACCOUNT]"
                        Password="[SERVICE_PASSWORD]"
                        Vital="yes">

          <!--
            Відновлення після збою: три спроби з наростанням, потім пауза.
            Четверта спроба НЕ робиться навмисно — служба, що вічно
            перезапускається, споживає ресурси і виглядає живою, тож збій
            лишається непоміченим (той самий принцип, що у ФВ-12.4a).

            ⛔ `DelayedAutoStart` тут НЕ через ServiceConfig (ні core-, ні
            util:-версію): компілятор відмовляє на `util:ServiceConfig` з
            цим атрибутом (WIX0004 — його там просто немає в 5.0.2), а
            core-версія компілюється, але власним попередженням компілятора
            (WIX1149) названа такою, що «документовано як не працює як
            очікується». Реєстровий ключ нижче — відомий надійний обхід:
            те саме, що ставить сам Windows, коли адміністратор вручну
            вмикає «Automatic (Delayed Start)» у services.msc.
          -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="none"
                              RestartServiceDelayInSeconds="30"
                              ResetPeriodInDays="1" />
        </ServiceInstall>

        <RegistryValue Root="HKLM"
                       Key="SYSTEM\CurrentControlSet\Services\EcrApi"
                       Name="DelayedAutoStart"
                       Type="integer"
                       Value="1" />

        <!--
          Stop="both" Remove="uninstall", БЕЗ Start="install" тут: старт
          винесено в окремий умовний компонент нижче (EcrServiceAutoStart)
          — ServiceControl/@Condition не підтримується компілятором
          (WIX0004, перевірено емпірично, та сама історія, що з
          util:PermissionEx у Folders.wxs). Stop/Remove лишаються
          безумовними: якщо службу колись запустили вручну (наприклад,
          пізніше додали обліковий запис через services.msc), оновлення й
          видалення однаково мають її зупинити/прибрати, незалежно від
          того, яким був SERVICE_ACCOUNT САМЕ ПІД ЧАС цієї конкретної
          установки.

          Без Stop при оновленні файли будуть заблоковані запущеним
          процесом, і MSI попросить перезавантаження — тобто оновлення
          служби стане простоєм сервера.
        -->
        <ServiceControl Id="EcrApiServiceControl"
                        Name="EcrApi"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />

        <!-- Джерело журналу подій: інакше служба пише в Application під іменем .NET Runtime. -->
        <util:EventSource Log="Application" Name="ECR"
                          EventMessageFile="%SystemRoot%\System32\EventCreate.exe" />

        <!--
          Правило брандмауера ЛИШЕ для профілю домену. Public і Private не
          відкриваються: система внутрішня, і випадкове ввімкнення
          публічного профілю на сервері не має відкривати порт у світ.
        -->
        <fw:FirewallException Id="EcrApiPort"
                              Name="!(loc.FirewallRuleName)"
                              Port="[APP_PORT]"
                              Protocol="tcp"
                              Scope="localSubnet"
                              Profile="domain" />
      </Component>

      <!--
        ⚠ Явний GUID, не "*": компонент без File — KeyPath стає самою
        текою, а такий компонент не приймає автогенерований GUID
        (WIX0230, той самий урок, що й LogsFolder у Folders.wxs).
        Умовний саме тому, що документована поведінка (docs/build/
        10-installer.md §1.4, сценарій 2 матриці) — «порожній обліковий
        запис → служба зареєстрована, але НЕ запущена», а не «запущена
        під LocalSystem за замовчуванням». Тип запуску в цьому разі —
        Manual (EcrApiDemandStart нижче, L10-03).
      -->
      <Component Id="EcrServiceAutoStart" Directory="INSTALLFOLDER"
                 Guid="4d8f2a71-9e3c-4b6d-a2f5-7c1e9b0d3a6f" Condition="SERVICE_ACCOUNT">
        <ServiceControl Id="EcrApiServiceStart" Name="EcrApi" Start="install" Wait="yes" />
      </Component>
    </ComponentGroup>

    <!--
      ⛔ L10-03 (аудит 2026-10-03): без облікового запису служба реєструється
      під LocalSystem, і Start="auto" вище підняв би її під LocalSystem після
      першого ж перезавантаження — всупереч §1.4 («краще явна ручна дія
      адміністратора»). ServiceInstall/@Start умови не має, а дві таблиці
      ServiceInstall на один exe неможливі (бінарник — KeyPath компонента),
      тому тип запуску міняється відкладеною дією ПІСЛЯ InstallServices:
      Manual (demand). З SERVICE_ACCOUNT — Auto, як і раніше; адміністратор,
      що потім задає обліковий запис вручну, ставить і автостарт.

      Умова — стан дії компонента ($EcrService = 3: ставиться чи
      перевстановлюється), тож на видаленні дія не йде, а на REINSTALL і
      оновленні — йде щоразу (властивість SERVICE_ACCOUNT не запам'ятовується).
    -->
    <SetProperty Id="EcrApiDemandStart" Sequence="execute" Before="EcrApiDemandStart"
                 Value="&quot;[System64Folder]sc.exe&quot; config EcrApi start= demand" />
    <CustomAction Id="EcrApiDemandStart" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="EcrApiDemandStart" After="InstallServices"
              Condition="NOT SERVICE_ACCOUNT AND $EcrService = 3" />
    </InstallExecuteSequence>
  </Fragment>
</Wix>
