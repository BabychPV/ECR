<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Fragment>

    <!-- 64-бітна тека: служба x64, у Program Files (x86) їй не місце. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="COMPANYFOLDER" Name="ECR">
        <Directory Id="INSTALLFOLDER" Name="Api" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="ECR">
        <Directory Id="LOGSFOLDER" Name="logs" />
        <Directory Id="CONFIGFOLDER" Name="config" />
      </Directory>
    </StandardDirectory>

    <!--
      Файли застосунку. Include забирає ВЕСЬ вихід публікації разом із
      рантаймом і статикою SPA: перелічувати файли руками означало б
      забути один при наступному релізі.

      ⚠ Справжня причина попередньої помилки WIX8602 «already been
      harvested» — НЕ цей елемент: `.wixproj` явно перелічував `Package.wxs`
      /`Folders.wxs`/`Service.wxs` в `<Compile Include=...>`, хоча
      WixToolset.Sdk (як і Microsoft.NET.Sdk) неявно бере всі `*.wxs` теки
      сам — кожен файл компілювався ДВІЧІ, і другий прохід `Files.Include`
      бачив уже оброблені файли першого. Прибрано явний ItemGroup — і
      власне цей, найпростіший механізм запрацював без змін.
    -->
    <!--
      Exclude Ecr.Api.exe: цей файл — окремий компонент у Service.wxs
      (KeyPath ServiceInstall/ServiceControl), інакше той самий файл
      потрапляє у два компоненти з різними GUID — WIX0369/WIX1070.
      Ecr.Worker.exe — з тієї ж причини, його компонент у Worker.wxs.

      ⚠ worker.settings.json лишається ТУТ, у теці застосунку, і оновлення
      його перезаписує — навмисно, це типові значення збірки (як
      appsettings.json), а не конфіг майданчика. Ecr.Worker читає його поруч
      з exe і не читає %ProgramData% (P1). Налаштування майданчика —
      змінні ECR_Jobs__Workers__* у Services\EcrWorker\Environment:
      вони перекривають файл і переживають оновлення. NeverOverwrite тут
      заморозив би типові значення першої установки назавжди, разом із
      ключами, яких тоді ще не було.
    -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**">
        <Exclude Files="$(PublishDir)\Ecr.Api.exe" />
        <Exclude Files="$(PublishDir)\Ecr.Worker.exe" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="AppFolders">

      <!--
        ⛔ L10-02 / N5-05 (аудит 2026-10-09): ACL на теку логів — ЗАХИЩЕНИЙ DACL.
        Колишній `util:PermissionEx User="Users"` лише ДОДАВАВ ACE «читання» до
        успадкованого: тека й далі успадковувала від %ProgramData% право
        BUILTIN\Users створювати файли й дописувати — чужий запис у наш журнал
        (підкладений файл/символьне посилання, підмінений ротаційний файл).

        Ядрове PermissionEx (таблиця MsiLockPermissionsEx, Windows Installer 5.0
        — InstallerVersion="500" у Package.wxs), бо лише SDDL задає «P» (без
        успадкування) — так само, як ConfigFolderAcl нижче. SYSTEM і
        Administrators — повний доступ, Users — лише читання й обхід (0x1200a9).
        `O:BAG:SY` — власник Administrators, група SYSTEM: див. примітку про
        власника біля DataFolderAcl нижче.

        Службі (SERVICE_ACCOUNT) потрібен ЗАПИС — він видається окремою
        відкладеною дією EcrLogsServiceAccountGrant нижче (icacls /grant
        ЗБЕРІГАЄ захищений DACL), а не `util:PermissionEx`: той пише DACL без
        PROTECTED_DACL_SECURITY_INFORMATION і знову вмикав би успадкування, тобто
        повертав би Users:Write саме на бойовому шляху (з SERVICE_ACCOUNT).
        Без облікового запису служба під LocalSystem — їй досить SYSTEM:FA.

        ⚠ Явний GUID, не "*": компонент, чий KeyPath — сама тека
        (CreateFolder без File), не приймає автогенерований GUID (WIX0230).
      -->
      <Component Id="LogsFolder" Directory="LOGSFOLDER" Guid="c1a9e6b2-4f3d-4e2a-9c7f-1a2b3c4d5e6f">
        <CreateFolder>
          <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
        </CreateFolder>
        <RemoveFolder Id="RemoveLogsFolder" On="uninstall" />
      </Component>

      <!--
        ⛔ N5-02 (аудит 2026-10-09): батьківська тека %ProgramData%\ECR — теж
        захищений DACL з власником Administrators. Якщо її заздалегідь створив
        локальний користувач, він лишається ВЛАСНИКОМ і має неявне право
        WRITE_DAC: після установки він міг би повернути собі доступ до logs і
        config.

        ⚠ Власника SDDL (`O:`) наявної теки Windows Installer може й не змінити:
        документація MsiLockPermissionsEx про `O:` мовчить, а зібрати WiX у
        цій лінії не було чим. Тому справжній бар'єр — дві перевірки ПОЗА MSI:
        `deploy-ecr.ps1` ВІДМОВЛЯЄТЬСЯ ставити, якщо власник теки ECR/config/logs
        не SYSTEM і не Administrators, а `verify-msi.ps1` перевіряє власника після
        установки. `O:BAG:SY` тут — перша спроба виправити власника, на свіжій
        теці власник і так SYSTEM (msiexec).
      -->
      <Component Id="DataFolderAcl" Directory="DATAFOLDER"
                 Guid="9b3f6d52-1e84-4c7a-a06d-5e2b8c4f7a19">
        <CreateFolder>
          <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
        </CreateFolder>
      </Component>

      <!--
        NeverOverwrite — атрибут КОМПОНЕНТА, не File (перевірено компілятором:
        на File — WIX0004, невідомий атрибут). Конфіг кладеться ОДИН РАЗ і
        переживає оновлення та видалення. Інакше кожне оновлення затирало б
        налаштування майданчика, і це виявилося б після рестарту служби.

        ⚠ «Переживає видалення» забезпечує Permanent="yes", а НЕ NeverOverwrite:
        NeverOverwrite лише забороняє перезапис при установці. Без Permanent
        `msiexec /x` прибирав appsettings.Production.json разом із порожньою
        текою config (лог c9.log: FileRemove appsettings.Production.json) —
        всупереч 10-installer.md («Не видаляє логи й конфіг при uninstall»).
        Знайшла реальна установка в CI (`msi-install (windows)`, сценарій 9).
      -->
      <Component Id="ConfigFolder" Directory="CONFIGFOLDER" Guid="*" NeverOverwrite="yes" Permanent="yes">
        <File Id="AppSettingsProd"
              Source="$(PublishDir)\appsettings.Production.json"
              KeyPath="yes" />
      </Component>

      <!--
        ⛔ L10-02 (аудит 2026-10-03): тека config НЕ успадковує права
        %ProgramData%. Там BUILTIN\Users мають право створювати файли, тобто
        будь-який локальний користувач міг підкласти bootstrap.secret (пароль
        першого адміністратора) або власний appsettings.Production.json.
        Захищений DACL (P — без успадкування): SYSTEM і Administrators —
        повний доступ, Users — лише читання й обхід (0x1200a9). Обліковий
        запис служби читає через Users (Authenticated Users — член
        BUILTIN\Users), а bootstrap.secret deploy-ecr.ps1 створює з власним
        захищеним ACL на обліковий запис служби.

        Ядрове PermissionEx (таблиця MsiLockPermissionsEx, Windows Installer
        5.0 — InstallerVersion="500" у Package.wxs), а не util:PermissionEx:
        лише SDDL задає «без успадкування». Окремий компонент без
        NeverOverwrite: ConfigFolder (NeverOverwrite) на оновленні не
        перевстановлюється, і на наявних серверах права лишились би старими.

        ⛔ Колишній ConfigFolderServiceAccountAcl (util:PermissionEx на
        SERVICE_ACCOUNT) прибрано свідомо: util пише DACL через
        SetNamedSecurityInfo без PROTECTED_DACL_SECURITY_INFORMATION, тобто
        знову вмикав би успадкування — і Users:Write повертався б.
      -->
      <Component Id="ConfigFolderAcl" Directory="CONFIGFOLDER"
                 Guid="2c6e8b14-7d3a-4f91-b5e0-9a4d1c7f2e83">
        <CreateFolder>
          <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
        </CreateFolder>
      </Component>

    </ComponentGroup>

    <!--
      ⛔ L10-02 / N5-05: запис служби в теку логів після того, як захищений DACL
      вже виставлено. Той самий механізм, що й EcrApiDemandStart (Service.wxs):
      відкладена WixQuietExec після InstallServices (MsiLockPermissionsEx
      обробляється в CreateFolders/InstallFiles/InstallServices — тобто ДО цієї
      дії). `icacls /grant` додає явний ACE і не чіпає прапорця захисту від
      успадкування. Modify (M), а не повний доступ: службі потрібні запис і
      ротація, але не WRITE_DAC/WRITE_OWNER. Шлях без кінцевого `\` перед
      лапкою (інакше `\"` екранує лапку).

      Умова — SERVICE_ACCOUNT і стан компонента LogsFolder ($LogsFolder = 3:
      ставиться чи перевстановлюється; DACL перезаписується щоразу, тож і
      грант — щоразу). Помилка icacls (немає такого облікового запису) зупиняє
      установку з відкатом, як і раніше зупиняв `util:PermissionEx`.
    -->
    <SetProperty Id="EcrLogsServiceAccountGrant" Sequence="execute" Before="EcrLogsServiceAccountGrant"
                 Value="&quot;[System64Folder]icacls.exe&quot; &quot;[CommonAppDataFolder]ECR\logs&quot; /grant &quot;[SERVICE_ACCOUNT]:(OI)(CI)M&quot;" />
    <CustomAction Id="EcrLogsServiceAccountGrant" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="EcrLogsServiceAccountGrant" After="InstallServices"
              Condition="SERVICE_ACCOUNT AND $LogsFolder = 3" />
    </InstallExecuteSequence>

    <!--
      ⚠ Логи при видаленні НЕ прибираються (RemoveFolder спрацює лише якщо
      тека порожня). Це навмисно: журнал переживає видалення застосунку.
      Прибирає адміністратор, якщо вважає потрібним.
    -->

  </Fragment>
</Wix>
