{
  "name": "ecr-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/patch-mantine-transition.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src e2e",
    "api:types": "openapi-typescript ../../contracts/openapi.snapshot.json -o src/api/schema.d.ts",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "budget": "node scripts/check-bundle-budget.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mantine/core": "7.15.2",
    "@mantine/dates": "7.15.2",
    "@mantine/form": "7.15.2",
    "@mantine/hooks": "7.15.2",
    "@mantine/notifications": "7.15.2",
    "@revolist/react-datagrid": "4.31.5",
    "@tanstack/react-query": "5.108.0",
    "dayjs": "1.11.23",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router-dom": "7.18.5",
    "zustand": "5.1.0"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.14.1",
    "eslint": "9.39.5",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.13.0",
    "pngjs": "^7.0.0",
    "terser": "5.51.2",
    "typescript": "5.7.2",
    "vite": "6.4.5",
    "vitest": "5.1.1"
  }
}
