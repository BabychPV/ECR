{
  "name": "ecr-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src e2e",
    "api:types": "openapi-typescript ../../contracts/openapi.snapshot.json -o src/api/schema.d.ts",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@formulajs/formulajs": "4.4.9",
    "@mantine/core": "7.15.2",
    "@mantine/dates": "7.15.2",
    "@mantine/form": "7.15.2",
    "@mantine/hooks": "7.15.2",
    "@mantine/notifications": "7.15.2",
    "@revolist/react-datagrid": "4.11.0",
    "@tanstack/react-query": "5.62.11",
    "dayjs": "1.11.13",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "react-router-dom": "7.18.3",
    "zod": "3.24.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.10.2",
    "eslint": "9.39.5",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.5.0",
    "pngjs": "^7.0.0",
    "typescript": "5.7.2",
    "vite": "6.4.3",
    "vitest": "5.0.0"
  }
}
