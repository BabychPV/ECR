<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ФВ-9.8 (D-206, крок P1): процес пулу перерахунку. Один exe у двох ролях:
    наглядач пулу під Windows Job Object і дочірній воркер (див. WorkerProgram).
    Дочірній (I1) виконує лейн перерахунку черги в базі тим самим JobWorker, що й Api.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ecr.Worker</RootNamespace>
    <!-- [LibraryImport] генерує unsafe-код маршалінгу; без цього SYSLIB1062. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- I1: те саме складання задач перерахунку, що в Ecr.Api (без веб-частини). -->
  <ItemGroup>
    <ProjectReference Include="..\Ecr.Application\Ecr.Application.csproj" />
    <ProjectReference Include="..\Ecr.Infrastructure\Ecr.Infrastructure.csproj" />
    <ProjectReference Include="..\Ecr.Calculations\Ecr.Calculations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <!-- Метрики дочірнього (ChildTelemetry): ті самі пакети й версії, що в Ecr.Api (CPM), нових немає. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <ItemGroup>
    <None Update="worker.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ecr.Worker.Tests" />
  </ItemGroup>

</Project>
