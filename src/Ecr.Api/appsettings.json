{
  "ConnectionStrings": {
    "Ecr": ""
  },
  "Schema": {
    "StartupMode": "Validate"
  },
  "Database": {
    "EditionMode": "Auto",
    "CommandTimeoutSeconds": 60,
    "BulkBatchSize": 50000,
    "SheetLockTimeoutSeconds": 30
  },
  "Cache": {
    "SchemaName": "dbo",
    "TableName": "Cache",
    "MetadataSlidingMinutes": 240,
    "AccessProfileSlidingMinutes": 60
  },
  "Auth": {
    "CookieName": "ecr.auth",
    "SlidingHours": 8,
    "RequireHttps": true,
    "EnableNegotiate": true,
    "StampCacheSeconds": 5
  },
  "Transport": {
    "Https": {
      "CertificateThumbprint": "",
      "Port": 0
    }
  },
  "Security": {
    "RateLimit": {
      "LoginPermitPerMinute": 60,
      "TrustForwardedFor": false,
      "SearchPermit": 30,
      "SearchWindowSeconds": 10,
      "CspReportPermitPerMinute": 120
    },
    "Csp": {
      "ReportOnly": true,
      "ReportUri": "/api/v1/csp-report",
      "Enforce": false
    }
  },
  "Jobs": {
    "ShutdownTimeoutSeconds": 120,
    "NightlyRecalculation": {
      "Enabled": false
    },
    "Queue": {
      "Mode": "Quartz"
    },
    "Recalculation": {
      "Executor": "InProcess"
    }
  },
  "Calculations": {
    "MaxParallelism": 4,
    "MaxInputCellsPerBinding": 300000,
    "FullYearWarnSeconds": 600
  },
  "Audit": {
    "ExportMaxRows": 100000
  },
  "Localization": {
    "ImportMaxBytes": 1048576
  },
  "Registries": {
    "ImportMaxBytes": 1048576
  },
  "Campaign": {
    "AtRiskDays": 3
  },
  "Integration": {
    "CatalogTimeoutSeconds": 10
  },
  "Notifications": {
    "WebhookAllowedHostSuffixes": ".webhook.office.com;.logic.azure.com;.powerplatform.com"
  },
  "Telemetry": {
    "Enabled": false,
    "ServiceName": "ecr-api",
    "OtlpEndpoint": "",
    "OtlpProtocol": "Grpc",
    "ExportIntervalSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "File": {
      "Directory": "%ProgramData%\\ECR\\logs",
      "RetainedFiles": 30,
      "FileSizeLimitMb": 100,
      "Json": true
    }
  },
  "AllowedHosts": "*"
}
