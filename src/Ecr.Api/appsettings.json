{
  "ConnectionStrings": {
    "Ecr": ""
  },
  "Schema": {
    "StartupMode": "Validate"
  },
  "Database": {
    "EditionMode": "Auto",
    "CommandTimeoutSeconds": 60,
    "RecalcCommandTimeoutSeconds": 180,
    "BulkBatchSize": 50000,
    "SheetLockTimeoutSeconds": 30,
    "MaxPoolSize": 200
  },
  "Cache": {
    "SchemaName": "dbo",
    "TableName": "Cache",
    "MetadataSlidingMinutes": 240,
    "AccessProfileSlidingMinutes": 60
  },
  "Auth": {
    "CookieName": "ecr.auth",
    "SlidingHours": 8,
    "RequireHttps": true,
    "EnableNegotiate": true,
    "Negotiate": {
      "AllowNtlm": false
    },
    "StampCacheSeconds": 5,
    "IdleTimeout": {
      "MinimumMinutes": 5
    }
  },
  "Transport": {
    "Https": {
      "CertificateThumbprint": "",
      "Port": 0
    }
  },
  "Security": {
    "RateLimit": {
      "LoginPermitPerMinute": 60,
      "TrustForwardedFor": false,
      "KnownProxies": "",
      "HealthReadyPermitPerMinute": 60,
      "ImportPreviewConcurrency": 2,
      "ImportPreviewQueueLimit": 4,
      "SearchPermit": 30,
      "SearchWindowSeconds": 10,
      "CspReportPermitPerMinute": 120,
      "AnonymousReadPermitPerMinute": 120,
      "SmtpTestPermitPerMinute": 5,
      "SmtpTestSystemPermitPerHour": 30,
      "RecalculatePermitPerMinute": 6,
      "RecalculateUserPermitPerMinute": 30,
      "VerifyPermitPerMinute": 100,
      "ValidatePermitPerMinute": 100,
      "DiscussionPostPermitPerMinute": 20,
      "ExportPermitPerMinute": 6
    },
    "LoginAttemptRetention": {
      "IntervalMinutes": 60,
      "Enabled": true
    },
    "Csp": {
      "ReportOnly": true,
      "ReportUri": "/api/v1/csp-report",
      "Enforce": false
    }
  },
  "Jobs": {
    "ShutdownTimeoutSeconds": 120,
    "NightlyRecalculation": {
      "Enabled": false
    },
    "Excel": {
      "MaxConcurrency": 2
    },
    "Queue": {
      "Mode": "Quartz"
    },
    "Quartz": {
      "ThreadCount": 16
    },
    "QueueDepth": {
      "RefreshSeconds": 15
    },
    "Recalculation": {
      "Executor": "InProcess",
      "MaxDeferralMinutes": 30
    }
  },
  "Health": {
    "RawDataPointWarnRows": 20000000,
    "WarmupOnStart": true
  },
  "Startup": {
    "WarmEditPath": true,
    "WarmEditPathMaxVersions": 20,
    "WarmFirstEdit": true
  },
  "Documents": {
    "StaleMap": {
      "MaxDop": 4
    },
    "StaleMapWarm": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "RingIntervalSeconds": 600,
      "HotPeriodLimit": 2
    },
    "VersionMigration": {
      "FromMonthEnabled": false
    }
  },
  "Calculations": {
    "MaxParallelism": 4,
    "MaxInputCellsPerBinding": 300000,
    "MaxRowEvaluationSteps": 20000000,
    "FullYearWarnSeconds": 600,
    "SupersededPurge": {
      "Enabled": true,
      "DeleteEnabled": true,
      "BatchSize": 500,
      "PauseMilliseconds": 50,
      "MaxBatchesPerRun": 5000,
      "NightWindow": "01:00-05:00",
      "IncludeTrace": true,
      "LogPauseThresholdPercent": 60,
      "LogPauseSeconds": 30,
      "MaxLogPauses": 20,
      "CheckpointEveryBatches": 50,
      "RebuildAfter": false
    }
  },
  "Audit": {
    "ExportMaxRows": 100000
  },
  "Retention": {
    "SubmissionSnapshots": {
      "Enabled": true,
      "DeleteEnabled": false,
      "RetainSnapshots": 5,
      "BatchSize": 10,
      "PauseMilliseconds": 500,
      "MaxBatchesPerRun": 200
    }
  },
  "Flert": {
    "Sync": {
      "Enabled": false,
      "DataSourceCode": "FLERT",
      "MaxDeactivatePercent": 10,
      "RecalculateDependents": false
    }
  },
  "Localization": {
    "ImportMaxBytes": 1048576
  },
  "AirLimits": {
    "NaeRegistryCode": "NAE_TREE",
    "SubstanceRegistryCode": "LAND_AIR_SUBSTANCE",
    "RegionRegistryCode": "LAND_REGION",
    "AreaRegistryCode": "AIR_AREA"
  },
  "NaeTree": {
    "RegionSourceRegistryCode": "LAND_REGION"
  },
  "Registries": {
    "ImportMaxBytes": 1048576,
    "ExportMaxRows": 50000
  },
  "Campaign": {
    "AtRiskDays": 3
  },
  "Collection": {
    "MonthColumnRouting": false,
    "ChunkDays": 7,
    "DeleteMissingPoints": true,
    "DeleteMissingOnSecondary": false
  },
  "Integration": {
    "CatalogTimeoutSeconds": 10,
    "RawDataExportMaxRows": 100000
  },
  "PiWebApi": {
    "AllowedHosts": [],
    "AllowInsecureHttp": false
  },
  "Smtp": {
    "AllowedPorts": []
  },
  "Notifications": {
    "WebhookAllowedHostSuffixes": ".webhook.office.com;.logic.azure.com;.powerplatform.com",
    "PublicBaseUrl": ""
  },
  "Telemetry": {
    "Enabled": false,
    "ServiceName": "ecr-api",
    "OtlpEndpoint": "",
    "OtlpProtocol": "Grpc",
    "ExportIntervalSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "File": {
      "Directory": "%ProgramData%\\ECR\\logs",
      "RetainedFiles": 30,
      "FileSizeLimitMb": 100,
      "Json": true
    }
  },
  "AllowedHosts": "*"
}
