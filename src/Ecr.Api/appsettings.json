{
  "ConnectionStrings": {
    "Ecr": ""
  },
  "Schema": {
    "StartupMode": "Validate"
  },
  "Database": {
    "EditionMode": "Auto",
    "CommandTimeoutSeconds": 60,
    "BulkBatchSize": 50000
  },
  "Cache": {
    "SchemaName": "dbo",
    "TableName": "Cache",
    "MetadataSlidingMinutes": 240,
    "AccessProfileSlidingMinutes": 60
  },
  "Auth": {
    "CookieName": "ecr.auth",
    "SlidingHours": 8,
    "RequireHttps": true,
    "EnableNegotiate": true,
    "StampCacheSeconds": 5
  },
  "Security": {
    "RateLimit": {
      "LoginPermitPerMinute": 60,
      "TrustForwardedFor": false
    }
  },
  "Jobs": {
    "NightlyRecalculation": {
      "Enabled": false
    }
  },
  "Campaign": {
    "AtRiskDays": 3
  },
  "Notifications": {
    "WebhookAllowedHostSuffixes": ".webhook.office.com;.logic.azure.com;.powerplatform.com"
  },
  "Telemetry": {
    "ServiceName": "ecr-api",
    "OtlpEndpoint": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "File": {
      "Directory": "%ProgramData%\\ECR\\logs",
      "RetainedFiles": 30,
      "FileSizeLimitMb": 100
    }
  },
  "AllowedHosts": "*"
}
