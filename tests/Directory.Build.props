<Project>

  <!--
    Успадковує кореневий Directory.Build.props і додає послаблення, які
    стосуються ВИКЛЮЧНО тестів (рев'ю Етапу 0, В-4). У src/ вони не діють.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      xUnit1026 — [Theory] із параметром, який тіло-заглушка Assert.Fail
                  ще не використовує. Зникне разом із заглушками, тому
                  лишається ВИДИМИМ попередженням, а не вимикається.

      CA1707 сюди більше не входить: він вимкнений у tests/.editorconfig.
      Причина різна за суттю — xUnit1026 колись перестане спрацьовувати,
      а CA1707 у тестах хибний назавжди.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);xUnit1026</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
