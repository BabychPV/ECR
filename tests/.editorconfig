# Успадковує кореневий .editorconfig; лише те, що стосується ВИКЛЮЧНО тестів.

[*.cs]
# CA1707 «прибрати підкреслення з імені» у тестах хибне ЗАВЖДИ: назви тестів
# українською з підкресленнями — вимога 08-workflow.md §9, і саме вони звіряються
# з каталогом 06*.md. Правило, яке в цій області не може бути правим, вимикається,
# а не лишається 984 попередженнями на кожній збірці: попередження, яке всі
# навчилися гортати, не діє — воно лише ховає ті, що діють (Q-064).
dotnet_diagnostic.CA1707.severity = none
