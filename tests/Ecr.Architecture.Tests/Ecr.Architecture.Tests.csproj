<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Ecr.Architecture.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ecr.Domain\Ecr.Domain.csproj" />
    <ProjectReference Include="..\..\src\Ecr.Application\Ecr.Application.csproj" />
    <ProjectReference Include="..\..\src\Ecr.Expressions\Ecr.Expressions.csproj" />
    <ProjectReference Include="..\..\src\Ecr.Infrastructure\Ecr.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Ecr.Calculations\Ecr.Calculations.csproj" />
    <ProjectReference Include="..\..\src\Ecr.Adapters.Excel\Ecr.Adapters.Excel.csproj" />
    <ProjectReference Include="..\..\src\Ecr.Adapters.PiAf\Ecr.Adapters.PiAf.csproj" />
    <ProjectReference Include="..\..\src\Ecr.Adapters.Sql\Ecr.Adapters.Sql.csproj" />
    <ProjectReference Include="..\..\src\Ecr.Api\Ecr.Api.csproj" />
    <ProjectReference Include="..\Ecr.TestKit\Ecr.TestKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <!--
    Чиста логіка майстра встановлення (tools/Ecr.Setup) — стан, параметри
    deploy-ecr.ps1. Посиланням на файли, а не ProjectReference: Ecr.Setup —
    net10.0-windows з WinForms і Microsoft.PowerShell.SDK, його не зібрати на
    Linux-раннері CI і не підключити до net10.0-проєкту. Підключені файли не
    залежать ні від WinForms, ні від PowerShell — саме для цього їх і винесено.
  -->
  <ItemGroup>
    <Compile Include="..\..\tools\Ecr.Setup\WizardState.cs" Link="Setup\Linked\WizardState.cs" />
    <Compile Include="..\..\tools\Ecr.Setup\DeployArguments.cs" Link="Setup\Linked\DeployArguments.cs" />
  </ItemGroup>

</Project>
