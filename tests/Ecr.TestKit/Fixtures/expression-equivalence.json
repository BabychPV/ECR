{
  "$comment": [
    "Спільний набір для тесту еквівалентності клієнт/сервер (06e).",
    "Читають ДВОЄ: Ecr.Expressions.Tests.ClientServerEquivalenceTests і vitest на клієнті.",
    "Клієнтський обчислювач — лише підказка під час введення; збережене значення завжди",
    "рахує сервер (D-20). Але якщо підказка систематично розходиться з результатом,",
    "користувач перестає їй вірити — тому набір спільний, а не два схожі.",
    "",
    "Вирази навмисно БЕЗ ПОСИЛАНЬ на комірки: набір має рахуватися однаково там, де",
    "документа немає взагалі. Посилання перевіряються GoldenFixtureTests.",
    "",
    "kind: number | text | boolean | null | error"
  ],
  "cases": [
    { "function": "SUM",     "expression": "SUM(1, 2, 3)",              "kind": "number",  "expected": "6" },
    { "function": "SUM",     "expression": "SUM(1, NULL, 2)",           "kind": "number",  "expected": "3" },
    { "function": "AVERAGE", "expression": "AVERAGE(10, 20)",           "kind": "number",  "expected": "15" },
    { "function": "AVERAGE", "expression": "AVERAGE(10, NULL, 20)",     "kind": "number",  "expected": "15" },
    { "function": "MIN",     "expression": "MIN(3, 1, 2)",              "kind": "number",  "expected": "1" },
    { "function": "MIN",     "expression": "MIN(3, NULL, 2)",           "kind": "number",  "expected": "2" },
    { "function": "MAX",     "expression": "MAX(3, 1, 2)",              "kind": "number",  "expected": "3" },
    { "function": "COUNT",   "expression": "COUNT(1, NULL, 3)",         "kind": "number",  "expected": "2" },
    { "function": "ROUND",   "expression": "ROUND(2.5, 0)",             "kind": "number",  "expected": "3" },
    { "function": "ROUND",   "expression": "ROUND(-2.5, 0)",            "kind": "number",  "expected": "-3" },
    { "function": "ROUND",   "expression": "ROUND(0.5, 0)",             "kind": "number",  "expected": "1" },
    { "function": "ROUND",   "expression": "ROUND(1.2345, 2)",          "kind": "number",  "expected": "1.23" },
    { "function": "ABS",     "expression": "ABS(-7.5)",                 "kind": "number",  "expected": "7.5" },
    { "function": "PRODUCT", "expression": "PRODUCT(2, 3, 4)",          "kind": "number",  "expected": "24" },
    { "function": "PRODUCT", "expression": "PRODUCT(2, NULL, 4)",       "kind": "number",  "expected": "8" },
    { "function": "IF",      "expression": "IF(1 > 0, 10, 20)",         "kind": "number",  "expected": "10" },
    { "function": "IF",      "expression": "IF(1 < 0, 10, 20)",         "kind": "number",  "expected": "20" },
    { "function": "IFERROR", "expression": "IFERROR(1 / 0, -1)",        "kind": "number",  "expected": "-1" },
    { "function": "IFERROR", "expression": "IFERROR(42, -1)",           "kind": "number",  "expected": "42" },
    { "function": "IFERROR", "expression": "IFERROR(NULL, -1)",         "kind": "null",    "expected": "" },
    { "function": "SUMIF",   "expression": "SUMIF(10, TRUE)",           "kind": "number",  "expected": "10" },
    { "function": "SUMIF",   "expression": "SUMIF(10, FALSE)",          "kind": "number",  "expected": "0" },

    { "function": "-",       "expression": "1 + 2 * 3",                 "kind": "number",  "expected": "7" },
    { "function": "-",       "expression": "(1 + 2) * 3",               "kind": "number",  "expected": "9" },
    { "function": "-",       "expression": "2 ^ 3 ^ 2",                 "kind": "number",  "expected": "512" },
    { "function": "-",       "expression": "-2 ^ 2",                    "kind": "number",  "expected": "-4" },
    { "function": "-",       "expression": "0.1 + 0.2",                 "kind": "number",  "expected": "0.3" },
    { "function": "-",       "expression": "7 % 4",                     "kind": "number",  "expected": "3" },
    { "function": "-",       "expression": "1 / 0",                     "kind": "error",   "expected": "#DIV/0" },
    { "function": "-",       "expression": "1 / NULL",                  "kind": "error",   "expected": "#DIV/0" },
    { "function": "-",       "expression": "NULL + 1",                  "kind": "null",    "expected": "" },
    { "function": "-",       "expression": "NULL * 0",                  "kind": "null",    "expected": "" },
    { "function": "-",       "expression": "NULL > 1",                  "kind": "null",    "expected": "" },
    { "function": "-",       "expression": "NULL = NULL",               "kind": "boolean", "expected": "true" },
    { "function": "-",       "expression": "NULL = 1",                  "kind": "boolean", "expected": "false" },
    { "function": "-",       "expression": "NULL & 'x'",                "kind": "text",    "expected": "x" },
    { "function": "-",       "expression": "'a' & 'b'",                 "kind": "text",    "expected": "ab" },
    { "function": "-",       "expression": "TRUE OR FALSE AND FALSE",   "kind": "boolean", "expected": "true" },
    { "function": "-",       "expression": "NOT 1 = 2",                 "kind": "boolean", "expected": "true" },
    { "function": "-",       "expression": "1 > 0 ? 'y' : 'n'",         "kind": "text",    "expected": "y" }
  ]
}
