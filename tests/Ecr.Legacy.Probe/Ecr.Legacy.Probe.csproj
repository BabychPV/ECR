<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ⛔ Вимірювальний стенд, а не частина системи. Тут стоїть NCalc 1.3.8 —
    обчислювач ЧИННОЇ системи (`sys.assemblies`: ncalc, version=1.3.8.0,
    publickeytoken=973cde3f1cafed03, тобто публічний пакет із NuGet).

    Проєкт не посилається на жоден наш і в поставку не входить. Його
    призначення одне: закріпити тестом поведінку, яку ми вичитали з вихідних
    текстів `DllProject` (директива №05 §2-ter), щоб `LegacyDoubleArithmetic`
    не мав жодної константи поведінки, взятої з припущення.
  -->
  <PropertyGroup>
    <RootNamespace>Ecr.Legacy.Probe</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!--
      ⚠ NCalc 1.3.8 зібраний під .NET Framework 4.0. Під .NET 10 він
      вантажиться через shim сумісності; попередження про це глушиться саме
      тут і лише тут — у продуктивному коді такої залежності немає.
    -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="NCalc" />
  </ItemGroup>

</Project>
