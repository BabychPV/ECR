<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Джерело пакетів закріплене НА РІВНІ РЕПОЗИТОРІЮ.

    Без цього файлу відновлення успадковує глобальний конфіг машини. За
    центрального керування пакетами (Directory.Packages.props) два джерела
    дають NU1507, а TreatWarningsAsErrors робить із нього помилку — і
    `dotnet ef migrations script` падає, тобто `tools/setup-dev-db.ps1` і
    `tools/smoke.ps1` не працюють у принципі. Повідомлення при цьому радить
    налаштувати package source mapping, що веде розробника не туди.

    <clear /> обов'язковий: без нього успадковані джерела лишаються.

    Це також вимога ліцензійної дисципліни (README §«Ліцензійна
    дисципліна»): перелік дозволених пакетів не має сенсу, поки джерело, з
    якого вони приходять, залежить від того, що випадково налаштовано в
    розробника.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
