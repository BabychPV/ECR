# ⛔ launchSettings.json тримає рядок підключення і разовий пароль bootstrap.
# Ні те, ні те не має потрапляти в репозиторій (D-11, ФВ-6.11), а сам файл
# у кожного свій. Готує базу і друкує потрібні змінні tools/setup-dev-db.ps1.
**/Properties/launchSettings.json

# ОС та IDE
.DS_Store
Thumbs.db
.idea/
*.swp

# ⚠ Реальні дані НІКОЛИ не потрапляють у репозиторій:
# на ПК-2 вони є, але це не привід їх комітити.
data/
*.xlsm
*.bak
*.dacpac
!docs/**/*.md

# Реальні дані з чинної системи (438 МБ: .xlsm, VBA, PI AF, SQL, SSRS) —
# лежать локально на ПК-2, у репозиторій не потрапляють.
source/

# Вхідні директиви ПК-1: робочий вхід, а не вміст репозиторію.
# Директиви №01…№03 у дереві теж немає — рішення з них живуть у
# `docs/tz/10-decisions.md`, а не в копії листа.
Down/

# Локальна конфігурація інструментів розробника (запуск dev-сервера тощо).
# ⚠ `.claude/*`, а НЕ `.claude/`: git не заходить усередину виключеного
# КАТАЛОГУ, тому винятки нижче з формою `.claude/` не діяли б зовсім.
.claude/*

# ⛔ Два винятки: у двовузловому процесі це НЕ локальна конфігурація, а частина
# контракту. Без спільного allow-списку headless-запуск (`claude -p`) зависає на
# першому підтвердженні команди, і планувальник мовчки не робить нічого —
# найгірший клас відмови, бо виглядає як порожня черга. `/cycle` має бути
# однаковим на обох вузлах з тієї ж причини.
!.claude/settings.json
!.claude/commands/
!.claude/commands/*.md

# Артефакти прогонів Playwright — у репозиторій не потрапляють (D-142).
src/Ecr.Web/test-results/
src/Ecr.Web/playwright-report/
src/Ecr.Web/e2e/__screenshots__/

# Локальний стан вузла: роль (NODE), журнали циклів, lock-файли.
# У кожної машини свій — у репозиторій не потрапляє.
.sync-local/
