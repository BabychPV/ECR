<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Ecr.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>EcrSetup</AssemblyName>

    <!--
      CA1001: кожен крок майстра тримає власні WinForms-контроли (TextBox,
      RadioButton тощо) як приватні поля — це IDisposable, і аналізатор
      хоче, щоб IWizardStep-реалізації самі стали IDisposable. Не варто:
      кожен контрол одразу додається у Controls свого контейнера
      (BuildView повертає його в ієрархію MainForm._content), і Windows
      Forms сама викликає Dispose() на кожному нащадку каскадно, коли
      Dispose() доходить до батьківської форми. Ручний IDisposable у
      кожному кроці був би мертвим кодом, що дублює те, що вже робить
      Control.Dispose(bool).
    -->
    <NoWarn>$(NoWarn);CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Версія — централізовано, Directory.Packages.props (LicenseComplianceTests
         звіряє, що жоден csproj не оголошує версію сам і не тягне пакет
         поза цим реєстром). -->
    <PackageReference Include="Microsoft.PowerShell.SDK" />
  </ItemGroup>

  <!--
    Q-219: `tools/build-installer.ps1` наповнює `artifacts\wizard-payload\`
    (Ecr.msi, deploy-ecr.ps1, migration.sql, sql\*.sql) ПЕРЕД публікацією —
    тека вже в кореневому `artifacts/` і тому й так поза git (.gitignore).
    `Link` знімає префікс `..\..\artifacts\wizard-payload\`, лишаючи лише
    те, що після нього: `Ecr.msi` — у корінь публікації, `sql\NN-*.sql` —
    у підтеку `sql\`. Разом із `-p:PublishSingleFile=true
    -p:IncludeAllContentForSelfExtract=true` (застосовується лише в
    `dotnet publish`, тут не заданий навмисно — звичайний `dotnet build`
    цієї зміни не потребує) це вбудовує payload У САМ .exe: сервер
    отримує РІВНО один файл, розпакування — в тимчасову теку при кожному
    запуску, куди й так уже дивляться ResolveScriptPath/TryDetectMsi
    (AppContext.BaseDirectory) — без жодної зміни коду майстра.
    Коли теки немає (build/publish без попереднього build-installer.ps1
    кроку) — глоб просто нічого не знаходить, помилки немає.
  -->
  <ItemGroup>
    <Content Include="..\..\artifacts\wizard-payload\**\*.*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
